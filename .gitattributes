* text=auto eol=lf
# License digests refer to the exact upstream bytes, including original line endings.
third_party/licenses/** -text

tests/corpus/files/** -text
tests/jpeg/*.jpg -text

# Preserve the exact Netpbm encoder output, including whitespace in plain raster data.
tests/netpbm/*.pbm binary
tests/netpbm/*.pgm binary
tests/netpbm/*.ppm binary
tests/netpbm/*.pam binary
